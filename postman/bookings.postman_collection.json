{
  "info": {
    "name": "Backend - Bookings localhost",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar npm run dev. Crear la reserva antes de consultar o agregar servicios. La creacion guarda bookingId automaticamente. serviceId=4 existe en el catalogo actual."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "serviceId",
      "value": "4"
    }
  ],
  "item": [
    {
      "name": "1 - Consultar servicios",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/services"
      }
    },
    {
      "name": "2 - Crear reserva",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user\": 7\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Reserva creada\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"bookingId\", pm.response.json().payload.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3 - Consultar reserva",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}"
      }
    },
    {
      "name": "4 - Agregar servicio (repetir para incrementar cantidad)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}/services/{{serviceId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"2026-11-10T15:00:00-03:00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "5 - Mismo servicio en otro horario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}/services/{{serviceId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"2026-11-11T15:00:00-03:00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "6 - Usuario invalido (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "7 - Fecha invalida (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}/services/{{serviceId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"no es una fecha\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "8 - Reserva inexistente (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings/999999"
      }
    },
    {
      "name": "9 - Servicio inexistente (404)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}/services/999999",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"2026-11-10T15:00:00-03:00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
